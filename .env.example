# Copy this file to .env and fill in your real values.
# Loaded automatically by config.py (via python-dotenv).

# ── Required ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here   # https://aistudio.google.com/apikey
ESP32_IP=192.168.1.72                      # from the ESP32 Serial Monitor

# ── Optional ──────────────────────────────────────────────────────────────
# Folder containing ffmpeg.exe, if it is not already on your PATH.
# FFMPEG_PATH=C:\path\to\ffmpeg\bin

# Audio capture/playback device:
#   pc    = PC microphone + speaker (default)
#   esp32 = INMP441 mic + MAX98357A speaker on the ESP32 (over HTTP)
# AUDIO_DEVICE=pc

# Tweak audio / model behaviour (defaults shown):
# SAMPLE_RATE=16000
# RECORD_SECONDS=5
# WHISPER_MODEL=base
# OLED_MAX_CHARS=80
# ESP32_TIMEOUT=3
